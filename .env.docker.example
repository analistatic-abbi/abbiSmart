# =============================================================================
# Smart Licitaciones — Docker (.env.docker.example)
# Copie a .env antes de: npm run docker:dev
# =============================================================================

# --- Aplicación ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# --- Base de datos (servicio mariadb en docker-compose) ---
DB_HOST=mariadb
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=rootpassword
DB_DATABASE=licitaciones_abbi

# --- CORS ---
CORS_ORIGINS=http://127.0.0.1:4200,http://localhost:4200

# --- Logging ---
LOG_LEVEL=info

# --- Seguridad ---
BCRYPT_ROUNDS=12
ACTIVATION_TOKEN_EXPIRES_HOURS=48
ADMIN_DEV_KEY=dev-secret-change-me
MAX_LOGIN_ATTEMPTS=5
SESSION_EXPIRES_DAYS=7
PRE_AUTH_EXPIRES_MINUTES=15
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# --- JWT (obligatorio: mínimo 32 caracteres) ---
JWT_ACCESS_SECRET=cambiar-por-secreto-aleatorio-minimo-32-caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cookie refresh token HttpOnly ---
COOKIE_REFRESH_NAME=abbi_refresh
COOKIE_REFRESH_PATH=/api/v1/auth
COOKIE_REFRESH_MAX_AGE=604800
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
COOKIE_DOMAIN=

# --- Mail SMTP (servidor ABBI — salida real, puerto 465 SSL) ---
MAIL_HOST=mailserver.abbi.com.co
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=notificacion-abbismart@abbi.com.co
MAIL_PASSWORD=
MAIL_FROM=notificacion-abbismart@abbi.com.co
MAIL_FROM_NAME=Notificaciones ABBI Smart
MAIL_SUPPORT_TO=pasanteabbi@gmail.com
FRONTEND_URL=http://127.0.0.1:4200

# --- Swagger ---
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
SWAGGER_TITLE=Smart Licitaciones API
SWAGGER_DESCRIPTION=API backend del sistema de gestión de licitaciones ABBI
SWAGGER_VERSION=1.0
